# Server
PORT=3000
CHECK_INTERVAL_HOURS=24
DATA_DIR=./data

# Tracking checker. Use "scrape" without UPS credentials, or "api" if you later
# get UPS OAuth credentials from https://developer.ups.com/.
TRACKER_MODE=scrape
UPS_SCRAPER_ENGINE=browser
UPS_BROWSER_CONCURRENCY=3
UPS_STATUS_TIMEOUT_MS=12000
UPS_SCRAPE_URL_TEMPLATE=https://www.ups.com/track?loc=en_US&tracknum={trackingNumber}&requester=ST/trackdetails
# Leave blank on Docker/Render so Playwright uses its bundled browser.
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ENV=production

# Email notifications via Resend. Leave blank to disable email.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Package Tracker <packages@example.com>
NOTIFY_EMAIL_TO=

# SMS notifications via Twilio. Leave blank to disable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

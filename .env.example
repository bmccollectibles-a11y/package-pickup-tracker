# Server
PORT=3000
CHECK_INTERVAL_HOURS=24
DATA_DIR=./data

# Tracking checker. The app uses Shippo only.
TRACKER_MODE=shippo
SHIPPO_API_TOKEN=
# Default carrier for ambiguous Auto carrier tracking numbers.
SHIPPO_CARRIER=ups
SHIPPO_TIMEOUT_MS=20000

# Email notifications via Resend. Leave blank to disable email.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Package Tracker <packages@example.com>
NOTIFY_EMAIL_TO=

# SMS notifications via Twilio. Leave blank to disable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
ADMIN_PASSWORD=
